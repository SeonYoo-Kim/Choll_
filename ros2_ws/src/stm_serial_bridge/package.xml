<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stm_serial_bridge</name>
  <version>0.1.0</version>
  <description>Bridge ROS2 /cmd_vel to the STM32 motor controller over USB serial.</description>
  <maintainer email="em-dev@anonymized.invalid">relu</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- STM 상태 토픽(/stm/*) 발행용. custom message는 만들지 않는다. -->
  <exec_depend>std_msgs</exec_depend>
  <!-- pyserial. Ubuntu 패키지명은 python3-serial (stm_serial_bridge/serial_link.py에서만 import) -->
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
